generator client {
  provider      = "prisma-client-js"
  engineType    = "library"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                    String              @id @default(uuid())
  email                 String              @unique
  passwordHash          String?
  firstName             String
  lastName              String
  role                  UserRole            @default(JOB_SEEKER)
  avatarUrl             String?
  phone                 String?
  telegramId            String?             @unique
  isActive              Boolean             @default(true)
  emailVerified         Boolean             @default(false)
  /// Set on successful session issuance (password/OAuth/2FA). Used by admin active-user metrics.
  lastLoginAt           DateTime?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  bio                   String?
  defaultResumeUrl      String?
  githubUrl             String?
  headline              String?
  linkedinUrl           String?
  location              String?
  portfolioUrl          String?
  skills                String[]            @default([])
  oauthAccounts         OAuthAccount[]
  applications          Application[]
  bids                  Bid[]
  candidateScores       CandidateScore[]
  freelanceMatchScores  FreelanceMatchScore[] @relation("FreelancerMatchScores")
  videoInterviews       VideoInterview[]
  chatParticipants      ChatParticipant[]
  company               Company?
  contractsAsClient     Contract[]          @relation("ContractClient")
  contractsAsFreelancer Contract[]          @relation("ContractFreelancer")
  freelanceJobs         FreelanceJob[]
  wallet                FreelancerWallet?
  employerWallet        EmployerWallet?
  messages              Message[]
  notifications         Notification[]
  refreshTokens         RefreshToken[]
  verificationTokens    VerificationToken[]
  savedJobs             SavedJob[]
  cvDraft               CvDraft?
  clientFeedback        Json?
  skillVerified         Boolean             @default(false)
  availabilities        UserAvailability[]  @relation("UserAvailabilities")
  employerInterviews    Interview[]         @relation("EmployerInterviews")
  candidateInterviews   Interview[]         @relation("CandidateInterviews")
  referralsGiven        Referral[]          @relation("ReferralReferrer")
  referralsReceived     Referral[]          @relation("ReferralReferred")
  jobAlerts             JobAlert[]
  payments              Payment[]
  forumThreads          ForumThread[]
  forumReplies          ForumReply[]
  forumUpvotes          ForumUpvote[]
  twoFactor             UserTwoFactor?
  kycVerified           Boolean             @default(false)
  kycVerification       KycVerification?
  subscriptions         Subscription[]
  rbacRoles             Role[]              @relation("UserRoles")

  gdprConsent             Boolean                  @default(true)
  aiFeedConsent           Boolean                  @default(true)
  searchHistories         SearchHistory[]
  notificationPreference  NotificationPreference?
  userPreference          UserPreference?
  storedFiles             StoredFile[]
  skillAssessmentSessions SkillAssessmentSession[]
  auditLogs             AuditLog[]
  promotionCampaigns    PromotionCampaign[]
  fraudAlerts             FraudAlert[]             @relation("AlertUser")
  resolvedFraudAlerts     FraudAlert[]             @relation("AlertResolver")

  email_logs              EmailLog[]
  speechConversations     SpeechConversation[]

  @@index([lastLoginAt])
  @@index([createdAt])
  @@map("users")
}

model Permission {
  id          String   @id @default(uuid())
  action      String   @unique
  description String?
  roles       Role[]   @relation("RolePermissions")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("permissions")
}

model Role {
  id          String       @id @default(uuid())
  name        String       @unique
  description String?
  isSystem    Boolean      @default(false)
  permissions Permission[] @relation("RolePermissions")
  users       User[]       @relation("UserRoles")
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@map("roles")
}

/// Theme and other small, non-identifying UI choices owned by a user.
/// This record deliberately contains no behavioural analytics or PII.
model UserPreference {
  id        String          @id @default(uuid())
  userId    String          @unique
  theme     ThemePreference @default(SYSTEM)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_preferences")
}

/// User-selected colour-scheme preference. `SYSTEM` delegates the resolved
/// colour scheme to the operating system and is the privacy-preserving default.
enum ThemePreference {
  LIGHT
  DARK
  SYSTEM
}

model NotificationPreference {
  id              String   @id @default(uuid())
  userId          String   @unique
  emailEnabled    Boolean  @default(true)
  telegramEnabled Boolean  @default(true)
  inAppEnabled    Boolean  @default(true)
  pushEnabled     Boolean  @default(false)
  smsEnabled      Boolean  @default(false)
  language        String   @default("en")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_preferences")
}
model OAuthAccount {
  id                    String        @id @default(uuid())
  userId                String
  provider              OAuthProvider
  providerAccountId     String
  encryptedAccessToken  String?
  encryptedRefreshToken String?
  tokenExpiresAt        DateTime?
  linkedAt              DateTime      @default(now())
  user                  User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("oauth_accounts")
}

model SearchHistory {
  id         String   @id @default(uuid())
  userId     String
  searchTerm String
  searchedAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, searchedAt])
  @@map("search_histories")
}

enum OAuthProvider {
  GOOGLE
  LINKEDIN
}
model SpeechConversation {
  id          String               @id @default(uuid())
  userId      String?
  title       String?
  description String?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  user        User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  transcripts SpeechTranscript[]
  messages    SpeechMessage[]

  @@index([userId, createdAt])
  @@map("speech_conversations")
}

model SpeechTranscript {
  id              String                  @id @default(uuid())
  conversationId  String
  audioUrl        String?
  videoUrl        String?
  duration        Int?
  rawText         String?
  normalizedText  String?
  language        String                  @default("en")
  confidence      Float?
  provider        String?
  processingTime  Int?
  status          SpeechTranscriptStatus  @default(PENDING)
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  conversation    SpeechConversation      @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  messages        SpeechMessage[]

  @@index([conversationId, createdAt])
  @@index([status])
  @@map("speech_transcripts")
}

model SpeechMessage {
  id              String              @id @default(uuid())
  conversationId  String
  transcriptId    String?
  content         String
  type            SpeechMessageType   @default(USER)
  sender          String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  conversation    SpeechConversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  transcript      SpeechTranscript?   @relation(fields: [transcriptId], references: [id], onDelete: SetNull)

  @@index([conversationId, createdAt])
  @@index([transcriptId])
  @@map("speech_messages")
}

enum SpeechTranscriptStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum SpeechMessageType {
  USER
  ASSISTANT
  SYSTEM
  NOTIFICATION
}

model SavedJob {
  id        String   @id @default(uuid())
  userId    String
  jobId     String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([userId, jobId])
  @@index([userId, createdAt])
  @@map("saved_jobs")
}

model CvDraft {
  id        String   @id @default(uuid())
  userId    String   @unique
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("cv_drafts")
}

model ContactMessage {
  id        String               @id @default(uuid())
  name      String
  email     String
  subject   String
  message   String
  status    ContactMessageStatus @default(NEW)
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  @@index([status, createdAt])
  @@index([email])
  @@map("contact_messages")
}

enum ContactMessageStatus {
  NEW
  READ
  RESOLVED
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model VerificationToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  type      String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("verification_tokens")
}

model Company {
  id            String   @id @default(uuid())
  name          String
  description   String?
  logoUrl       String?
  website       String?
  industry      String?
  size          String?
  verified      Boolean  @default(false)
  userId        String   @unique
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  benefits      String[] @default([])
  coverImageUrl String?
  facebookUrl   String?
  foundedYear   Int?
  linkedinUrl   String?
  location      String?
  twitterUrl    String?
  user          User     @relation(fields: [userId], references: [id])
  jobs          Job[]

  @@map("companies")
}

model JobCategory {
  id    String  @id @default(uuid())
  slug  String  @unique
  label String
  icon  String?
  jobs  Job[]

  @@map("job_categories")
}

model Job {
  id                       String        @id @default(uuid())
  title                    String
  description              String
  requirements             String?
  location                 String
  type                     JobType
  categoryId               String
  salaryMin                Int?
  salaryMax                Int?
  currency                 String        @default("ETB")
  deadline                 DateTime?
  status                   JobStatus     @default(DRAFT)
  featured                 Boolean       @default(false)
  companyId                String
  createdAt                DateTime      @default(now())
  updatedAt                DateTime      @updatedAt
  applyEmail               String?
  applyType                String?
  applyUrl                 String?
  companyLogo              String?
  companyName              String?
  contactPhone             String?
  experienceLevel          String?
  expiryDate               DateTime?
  filled                   Boolean       @default(false)
  gender                   String?
  jobSite                  String?
  qualification            String?
  salaryType               String?
  interviewDurationMinutes Int           @default(60)
  tags                     String[]      @default([])
  urgent                   Boolean       @default(false)
  vacancies                Int?          @default(1)
  yearsOfExperience        String?
  applications             Application[]
  questions                JobQuestion[]
  savedBy                  SavedJob[]
  category                 JobCategory   @relation(fields: [categoryId], references: [id])
  company                  Company       @relation(fields: [companyId], references: [id])

  @@index([title, location])
  @@index([status, featured])
  @@index([companyId, status])
  @@index([categoryId, status])
  @@index([expiryDate])
  @@map("jobs")
}

model JobQuestion {
  id        String   @id @default(uuid())
  jobId     String
  question  String
  type      String   @default("TEXT")
  options   String[] @default([])
  required  Boolean  @default(false)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
  @@map("job_questions")
}

model Application {
  id               String            @id @default(uuid())
  jobId            String
  userId           String
  coverLetter      String?
  resumeUrl        String?
  status           ApplicationStatus @default(SUBMITTED)
  interviewSlot    DateTime?
  notes            String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  expectedSalary   Int?
  portfolioUrl     String?
  screeningAnswers Json?
  job              Job               @relation(fields: [jobId], references: [id])
  user             User              @relation(fields: [userId], references: [id])
  score            CandidateScore?
  videoInterview   VideoInterview?
  interview        Interview?

  @@unique([jobId, userId])
  @@index([userId, status])
  @@index([jobId, status])
  @@map("applications")
}

model CandidateScore {
  id              String      @id @default(uuid())
  applicationId   String      @unique
  userId          String
  overallScore    Float
  skillScore      Float
  experienceScore Float
  cultureFitScore Float?
  reasoning       String?
  rawAiResponse   Json?
  modelUsed       String      @default("gpt-4o-mini")
  scoredAt        DateTime    @default(now())
  application     Application @relation(fields: [applicationId], references: [id])
  user            User        @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("candidate_scores")
}

model FreelanceCategory {
  id    String         @id @default(uuid())
  slug  String         @unique
  label String
  icon  String?
  jobs  FreelanceJob[]

  @@map("freelance_categories")
}

model FreelanceJob {
  id                 String             @id @default(uuid())
  title              String
  description        String
  categoryId         String
  clientId           String
  budgetMin          Int
  budgetMax          Int
  currency           String             @default("ETB")
  pricingType        String             @default("FIXED")
  deadlineDays       Int
  skills             String[]
  status             FreelanceJobStatus @default(DRAFT)
  featured           Boolean            @default(false)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  attachments        String[]           @default([])
  experienceLevel    String?
  locationPreference String?
  bids               Bid[]
  matchScores        FreelanceMatchScore[]
  contract           Contract?
  escrowTx           EscrowTransaction?
  category           FreelanceCategory  @relation(fields: [categoryId], references: [id])
  client             User               @relation(fields: [clientId], references: [id])

  @@map("freelance_jobs")
}

model Bid {
  id             String       @id @default(uuid())
  freelanceJobId String
  freelancerId   String
  amount         Int
  timelineDays   Int
  coverLetter    String
  status         BidStatus    @default(PENDING)
  qualityScore   Float?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  freelanceJob   FreelanceJob @relation(fields: [freelanceJobId], references: [id])
  freelancer     User         @relation(fields: [freelancerId], references: [id])

  @@unique([freelanceJobId, freelancerId])
  @@map("bids")
}

model Contract {
  id             String         @id @default(uuid())
  freelanceJobId String         @unique
  clientId       String
  freelancerId   String
  agreedAmount   Int
  currency       String         @default("ETB")
  status         ContractStatus @default(ACTIVE)
  startedAt      DateTime       @default(now())
  completedAt    DateTime?
  updatedAt      DateTime       @updatedAt
  client         User           @relation("ContractClient", fields: [clientId], references: [id])
  freelanceJob   FreelanceJob   @relation(fields: [freelanceJobId], references: [id])
  freelancer     User           @relation("ContractFreelancer", fields: [freelancerId], references: [id])
  dispute        Dispute?
  milestones     Milestone[]

  @@map("contracts")
}

model Milestone {
  id                   String          @id @default(uuid())
  contractId           String
  title                String
  description          String?
  amount               Int
  deadline             DateTime
  status               MilestoneStatus @default(PENDING)
  approvedAt           DateTime?
  employerApprovedAt   DateTime?
  freelancerApprovedAt DateTime?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
  deliverables         Deliverable[]
  contract             Contract        @relation(fields: [contractId], references: [id])

  @@map("milestones")
}

model Deliverable {
  id          String    @id @default(uuid())
  milestoneId String
  fileUrl     String?
  notes       String?
  submittedAt DateTime  @default(now())
  milestone   Milestone @relation(fields: [milestoneId], references: [id])

  @@map("deliverables")
}

model EscrowTransaction {
  id                  String       @id @default(uuid())
  freelanceJobId      String       @unique
  grossAmount         Int
  platformFee         Int
  netAmount           Int
  walletAppliedAmount Int          @default(0)
  currency            String       @default("ETB")
  status              EscrowStatus @default(PENDING)
  gatewayRef          String?
  gatewayResponse     Json?
  fundedAt            DateTime?
  releasedAt          DateTime?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  freelanceJob        FreelanceJob @relation(fields: [freelanceJobId], references: [id])

  @@map("escrow_transactions")
}

model FreelancerWallet {
  id               String              @id @default(uuid())
  userId           String              @unique
  pendingBalance   Int                 @default(0)
  availableBalance Int                 @default(0)
  currency         String              @default("ETB")
  updatedAt        DateTime            @updatedAt
  user             User                @relation(fields: [userId], references: [id])
  transactions     WalletTransaction[]

  @@map("freelancer_wallets")
}

model WalletTransaction {
  id          String                @id @default(uuid())
  walletId    String
  type        WalletTransactionType
  amount      Int
  note        String?
  milestoneId String?
  createdAt   DateTime              @default(now())

  // Webhook integration fields
  externalTransactionId String? @unique // Stripe charge ID, PayPal order ID, etc.
  status                String? // pending, completed, failed, refunded
  metadata              Json? // Additional provider-specific data

  wallet FreelancerWallet @relation(fields: [walletId], references: [id])

  @@index([walletId, createdAt])
  @@index([externalTransactionId])
  @@map("wallet_transactions")
}

model EmployerWallet {
  id            String                      @id @default(uuid())
  userId        String                      @unique
  balance       Int                         @default(0)
  lockedBalance Int                         @default(0)
  currency      String                      @default("ETB")
  updatedAt     DateTime                    @updatedAt
  user          User                        @relation(fields: [userId], references: [id])
  transactions  EmployerWalletTransaction[]

  @@map("employer_wallets")
}

model EmployerWalletTransaction {
  id        String                @id @default(uuid())
  walletId  String
  type      WalletTransactionType
  amount    Int
  note      String?
  escrowId  String?
  createdAt DateTime              @default(now())
  wallet    EmployerWallet        @relation(fields: [walletId], references: [id])

  @@index([walletId, createdAt])
  @@map("employer_wallet_transactions")
}

model Dispute {
  id           String    @id @default(uuid())
  contractId   String    @unique
  raisedById   String
  reason       String
  evidenceUrls String[]
  resolution   String?
  resolvedById String?
  refundAmount Int?
  refundCurrency String?
  resolvedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  contract     Contract  @relation(fields: [contractId], references: [id])

  @@map("disputes")
}

model Notification {
  id        String              @id @default(uuid())
  userId    String
  channel   NotificationChannel @default(IN_APP)
  type      String
  title     String
  body      String
  read      Boolean             @default(false)
  metadata  Json?
  createdAt DateTime            @default(now())
  user      User                @relation(fields: [userId], references: [id])

  @@index([userId, read])
  @@index([userId, createdAt])
  @@map("notifications")
}

model EventLog {
  id           String   @id @default(uuid())
  eventType    String
  entityId     String
  entityType   String
  payload      Json
  processedBy  String?
  actorUserId  String?
  ipAddress    String?
  httpMethod   String?
  path         String?
  statusCode   Int?
  durationMs   Int?
  createdAt    DateTime @default(now())

  @@index([eventType, entityId])
  @@index([createdAt], map: "idx_events_log_created_at")
  @@index([entityType], map: "idx_events_log_entity_type")
  @@index([eventType, entityId, createdAt])
  @@index([createdAt])
  @@index([actorUserId, createdAt])
  @@index([path, createdAt])
  @@map("events_log")
}

model ChatRoom {
  id           String            @id @default(uuid())
  contractId   String?           @unique
  jobId        String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  participants ChatParticipant[]
  messages     Message[]

  @@map("chat_rooms")
}

model ChatParticipant {
  id         String    @id @default(uuid())
  roomId     String
  userId     String
  joinedAt   DateTime  @default(now())
  lastReadAt DateTime?
  room       ChatRoom  @relation(fields: [roomId], references: [id])
  user       User      @relation(fields: [userId], references: [id])

  @@unique([roomId, userId])
  @@map("chat_participants")
}

model Message {
  id        String   @id @default(uuid())
  roomId    String
  senderId  String
  content   String
  isSystem  Boolean  @default(false)
  metadata  Json?
  createdAt DateTime @default(now())
  room      ChatRoom @relation(fields: [roomId], references: [id])
  sender    User     @relation(fields: [senderId], references: [id])

  @@index([roomId, createdAt])
  @@map("messages")
}

model UserAvailability {
  id        String   @id @default(uuid())
  userId    String
  startTime DateTime
  endTime   DateTime
  timezone  String   @default("UTC")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation("UserAvailabilities", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([startTime, endTime])
  @@map("user_availability")
}

model Interview {
  id            String @id @default(uuid())
  applicationId String @unique

  employerId  String
  candidateId String

  startTime       DateTime
  endTime         DateTime
  durationMinutes Int      @default(60)

  timezone String @default("UTC")

  meetingLink String?

  notes String?

  status InterviewStatus @default(SCHEDULED)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  employer    User        @relation("EmployerInterviews", fields: [employerId], references: [id])
  candidate   User        @relation("CandidateInterviews", fields: [candidateId], references: [id])

  @@index([candidateId, startTime])
  @@index([employerId, startTime])
  @@index([employerId])
  @@index([candidateId])
  @@index([startTime])
  @@map("interviews")
}

model UserTwoFactor {
  id                   String       @id @default(uuid())
  userId               String       @unique
  secret               String
  encryptionKeyVersion String       @default("v1")
  enabled              Boolean      @default(false)
  enrollmentToken      String?
  enrollmentExpiresAt  DateTime?
  lastVerifiedAt       DateTime?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
  user                 User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  backupCodes          BackupCode[]

  @@map("user_two_factor")
}

model BackupCode {
  id          String        @id @default(uuid())
  twoFactorId String
  codeHash    String
  usedAt      DateTime?
  createdAt   DateTime      @default(now())
  twoFactor   UserTwoFactor @relation(fields: [twoFactorId], references: [id], onDelete: Cascade)

  @@index([twoFactorId])
  @@map("backup_codes")
}

model SalaryPrediction {
  id              String  @id @default(uuid())
  jobTitle        String
  jobCategoryId   String?
  industry        String?
  location        String
  experienceLevel String? // JUNIOR, MID, SENIOR, LEAD, etc.
  currency        String  @default("ETB")

  // Salary ranges calculated from market data
  minSalary     Int
  maxSalary     Int
  averageSalary Int // Mean of all salary data points
  medianSalary  Int // Median salary from dataset

  // Statistical data
  dataPointsCount   Int   @default(0) // Number of job postings used in calculation
  standardDeviation Float @default(0)
  confidenceScore   Float @default(0.5) // 0.0 - 1.0, higher = more reliable

  // Version tracking for updates
  version       Int      @default(1)
  lastUpdatedAt DateTime @updatedAt
  createdAt     DateTime @default(now())

  // For GDPR compliance
  isAnonymized Boolean @default(true)

  // For optimization
  @@index([jobTitle, location, experienceLevel])
  @@index([jobCategoryId, location])
  @@index([location, industry])
  @@index([lastUpdatedAt])
  @@map("salary_predictions")
}

// SalaryHistory Model - Audit trail for salary predictions
// Maintains historical records of salary trends over time
model SalaryHistory {
  id              String  @id @default(uuid())
  jobTitle        String
  jobCategoryId   String?
  industry        String?
  location        String
  experienceLevel String?
  currency        String  @default("ETB")

  // Historical snapshot
