{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "plugins": ["@nestjs/swagger"],
    "assets": [
      { "include": "i18n/**/*", "outDir": "dist/src" },
      { "include": "modules/email-automation/templates/**/*", "outDir": "dist/src" }
    ],
    "watchAssets": true
  }
}
