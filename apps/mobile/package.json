    "@babel/core": "^7.25.2",
    "@types/react": "~18.2.79",
    "@types/react-native": "~0.74.0",
    "typescript": "^5.3.3",
    "eslint": "^8.57.0",
    "eslint-config-expo": "~8.0.1",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
