    "axios": "^1.7.7",
    "date-fns": "^3.6.0",
    "expo": "^57.0.0",
    "expo-audio": "~57.0.5",
    "expo-build-properties": "^57.0.17",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.18",
    "expo-crypto": "~57.0.4",
    "expo-document-picker": "~57.0.2",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-image-picker": "~57.0.17",
