# Beleqet Jobs bot (@BeleqetJobs_Bot): the settings main.py reads.
# On the server this file is /opt/beleqet/job/.env (chmod 600); deploys never overwrite it.

# Telegram bot token from @BotFather
BOT_TOKEN=
# Comma-separated Telegram user ids that can use the bot's admin commands
ADMIN_IDS=

# The API's bot registration endpoint, e.g. http://127.0.0.1:4000/api/v1/telegram/register.
# The other bot endpoints are found next to it. (The name is from when this pointed at WordPress.)
WORDPRESS_API_URL=
# Sent as X-Beleqet-API-Token; same value as the API's TELEGRAM_BOT_API_TOKEN
BELEQET_API_SECRET_TOKEN=

# Website the bot's buttons open (default https://beleqetjobs.com)
MINI_APP_URL=
# SGS Challenge Mini App, served by this bot under /challenge (e.g. https://beleqetjobs.com/challenge)
CHALLENGE_MINI_APP_URL=

# Telegram file ids of the welcome pictures for job seekers and employers (optional)
CANDIDATE_PROMO_PHOTO_ID=
EMPLOYER_PROMO_PHOTO_ID=

# Checked on the X-Telegram-Bot-Api-Secret-Token header of webhook calls: openssl rand -hex 32
WEBHOOK_SECRET_TOKEN=
# Not read by the code at present; kept for webhook mode
BOT_WEBHOOK_URL=

# Port of the bot's web server (SGS Challenge and webhook), default 8082
PORT=
