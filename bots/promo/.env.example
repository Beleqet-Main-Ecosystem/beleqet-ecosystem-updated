# Telegram bot (@BotFather)
BOT_TOKEN=
# Telegram user id that gets manual deposits to approve; only this account's Approve/Reject count
ADMIN_ID=

# Public address of the Mini App and webhook (no trailing slash)
WEBHOOK_DOMAIN=https://promo.beleqetjobs.com
# Random string Telegram sends with every update: openssl rand -hex 32
WEBHOOK_SECRET_TOKEN=

# SMM panel (smmland.com) API key. Orders are paid from that account's balance (in USD).
SMM_API_KEY=
# The admin is told in Telegram when the SMMLand balance drops below this many dollars
SMM_LOW_BALANCE_USD=10
# Chapa secret key, for Add Funds by Telebirr / CBE Birr / card
CHAPA_SECRET_KEY=

# Where manual (bank transfer) deposits go, shown in the Mini App. Manual deposits are only offered
# once both the account and the name are set.
MANUAL_DEPOSIT_BANK=CBE
MANUAL_DEPOSIT_ACCOUNT=
MANUAL_DEPOSIT_NAME=

# Shared with the referral bots (Boost and Go, both bots/referral; same value in their .env).
# While it's empty, no transfers are accepted.
TRANSFER_SECRET_KEY=
