# Chapa secret key, for Add Funds by Telebirr / CBE Birr / card
CHAPA_SECRET_KEY=

# Shared with the referral bots (bots/boost and bots/go, same value there).
# While it's empty, no transfers are accepted.
TRANSFER_SECRET_KEY=
