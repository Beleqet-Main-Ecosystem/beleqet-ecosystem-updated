NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_SITE_URL=http://localhost:3001
NEXT_PUBLIC_ADMIN_URL=http://localhost:3000
# Bot behind "Sign in with Telegram" (default: the Jobs bot, 7902805005). Its domain must be set
# in @BotFather with /setdomain.
# NEXT_PUBLIC_TELEGRAM_LOGIN_BOT_ID=7902805005

# Production values (set these in the actual environment, not here):
# NEXT_PUBLIC_API_URL=https://api.beleqetjobs.com/api/v1
# NEXT_PUBLIC_SITE_URL=https://beleqetjobs.com
# NEXT_PUBLIC_ADMIN_URL=https://admin.beleqetjobs.com
# Payment domain (beleqetpay.com is now the canonical payment entry point):
# NEXT_PUBLIC_PAYMENT_BASE_URL=https://beleqetpay.com

# Groq AI for support chat and CV assistance (server-side only)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
