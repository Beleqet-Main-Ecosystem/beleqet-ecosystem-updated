<!doctype html>
<html>
  <body style="font-family: Arial, sans-serif; color: #1a1a1a;">
    <h2>Payment receipt</h2>
    <p>Thank you, {{name}}. Here is your receipt.</p>
    <table style="border-collapse: collapse; width: 100%;">
      <tr><td style="padding: 4px 0;">Transaction ID</td><td>{{transactionId}}</td></tr>
      <tr><td style="padding: 4px 0;">Amount</td><td>{{amount}} {{currency}}</td></tr>
      <tr><td style="padding: 4px 0;">Date</td><td>{{paidAt}}</td></tr>
    </table>
    <p style="font-size: 12px; color: #6b7280;">
      Keep this email as your official receipt.
    </p>
  </body>
</html>
